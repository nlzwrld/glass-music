# Personal Zero-Trust Hub & SoundCloud broker configuration for Liquid Hub.
# Public shared catalog deployments use deploy/catalog.env.example instead.
# Copy to .env only for your self-hosted broker server. Never commit secrets.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# Optional static owner token (Zero-Trust OAuth2 + PKCE S256 + Ed25519 JWT is enabled by default).
BROKER_ACCESS_TOKEN=
BROKER_PORT=8787
BROKER_IP_RPM=60
BROKER_USER_RPM=45
# Public deployments: reverse proxy with TLS (see deploy/Caddyfile).
SOUNDCLOUD_BROKER_URL=http://127.0.0.1:8787
# Signed updates use GitHub Releases; see deploy/updates.md.
