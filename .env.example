# Legacy personal broker example. Glass Music 1.4 uses deploy/catalog.env.example instead.
# Desktop users no longer enter credentials. See docs/INTEGRACOES.md.
# Copy to .env only for the legacy separate SoundCloud server. Never commit secrets.
# SoundCloud secrets belong ONLY to the separate server below.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# Long random token authenticating your personal desktop to your broker.
BROKER_ACCESS_TOKEN=
BROKER_PORT=8787
# Public deployments: reverse proxy with TLS; no public anonymous access.
SOUNDCLOUD_BROKER_URL=http://127.0.0.1:8787
# Signed updates use GitHub Releases; see deploy/updates.md.
# Windows signing must be configured separately in the Tauri bundle settings.
