{
  "name": "liquid-hub",
  "productName": "Liquid Hub",
  "version": "2.2.0",
  "description": "Hub centralizado de músicas, catálogos multiplataforma e sessões JAM ao vivo para Windows.",
  "author": "Liquid Hub",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/tauri.mjs dev",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/tauri.mjs dev",
    "test": "vitest run",
    "android:check": "node scripts/android-beta.mjs check",
    "android:setup": "node scripts/android-beta.mjs setup",
    "android:apk": "node scripts/android-beta.mjs apk",
    "android:aab": "node scripts/android-beta.mjs aab",
    "test:native": "node scripts/cargo.mjs test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "dist": "node scripts/tauri.mjs build",
    "broker": "node --env-file-if-exists=.env --experimental-strip-types server/broker.ts",
    "catalog": "node --env-file-if-exists=deploy/.env --experimental-strip-types server/catalog.ts",
    "jam": "node --env-file-if-exists=.env --experimental-strip-types server/jam.ts",
    "configure:catalog": "node scripts/configure-catalog.mjs",
    "catalog:binaries": "node scripts/configure-catalog.mjs --ensure-binaries"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-virtual": "3.14.26",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "liquid-glass-react": "1.1.1",
    "lucide-react": "1.73.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
