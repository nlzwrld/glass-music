{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glass Music",
  "version": "2.2.0",
  "identifier": "com.glassmusic.desktop",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "node scripts/build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glass Music",
        "width": 1360,
        "height": 860,
        "minWidth": 920,
        "minHeight": 650,
        "decorations": false,
        "center": true,
        "useHttpsScheme": true,
        "backgroundColor": "#00000000",
        "devtools": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; connect-src ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:*; frame-src http://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; connect-src ws://127.0.0.1:5173 ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:*; frame-src http://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Music",
    "shortDescription": "Sua m\u00fasica, em outra atmosfera.",
    "icon": [
      "../assets/icon.ico",
      "../assets/icon.png"
    ],
    "resources": {
      "../assets/catalog/": "catalog/"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "PortugueseBR"
        ],
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyNEY1RTA4OTI0MDI2NTMKUldSVEprQ1NDRjVQd2lrcWFoWnVzOG5WRm1oWm1WMWJxMklSdXVwQU1oeUwyNFY0U1pRMjlkdTMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
