# Owner-only configuration. Copy to deploy/.env on the server. Never include it in the installer.
CATALOG_DOMAIN=catalog.seu-dominio.com
YOUTUBE_API_KEY=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
CATALOG_REGION=BR
# Local safeguards; the platforms still enforce the actual project quotas.
YOUTUBE_DAILY_SEARCH_LIMIT=90
CATALOG_REQUESTS_PER_MINUTE=40
CATALOG_UPSTREAM_REQUESTS_PER_MINUTE=30
